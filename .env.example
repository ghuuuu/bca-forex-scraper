# Copy to `.env` beside docker-compose.yml and fill in.
#
# The Cloudflare Tunnel token, from Zero Trust -> Networks -> Tunnels -> your
# tunnel -> Configure. It is a credential: it authorises a connection into this
# machine, so treat it like a password. `.env` is gitignored — keep it that way,
# and never paste the token into docker-compose.yml itself.
#
# Leave this unset and comment out the `tunnel` service to run LAN-only.
TUNNEL_TOKEN=
