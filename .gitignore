# The collected history and anything derived from it — machine-local, and it
# would otherwise grow in the repo forever. Delete this file if you decide the
# history should travel with the folder.
# The folders themselves are kept, only their contents are ignored: Docker on
# Synology refuses to start when a bind-mount source is missing, so `data/` and
# `web/` have to exist in the copied folder before compose runs.
data/*
!data/.gitkeep
web/*
!web/.gitkeep
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.csv

# Build output — regenerated from the database on demand, ~100 KB of mostly
# embedded logo, and it would land in every diff. The saved page under
# tests/fixtures/ is a real input, so this is deliberately root-only.
/chart.html

# The Cloudflare Tunnel token authorises a connection into this machine. It
# belongs on the NAS and nowhere else — .env.example is the tracked template.
.env

__pycache__/
*.pyc

# Synology's indexing service drops these metadata folders into anything it
# touches. Left untracked they are only noise, but when one lands inside
# .git/refs/heads/ git reads it as a ref and every fetch dies with
# "fatal: bad object refs/heads/@eaDir/main@SynoEAStream".
@eaDir/
*@SynoEAStream
